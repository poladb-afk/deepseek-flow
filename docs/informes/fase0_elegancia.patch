+    def tamano(valor):
+        return len(valor) if isinstance(valor, list) else (valor or 0)
+
+    return [f"    {clave}: {tamano(previo.get(clave))} → {tamano(valor)}"
+            for clave, valor in actual.items() if tamano(valor) > tamano(previo.get(clave))]
