# Copia este archivo a .env y ajusta lo que necesites.
# La API key de DeepSeek NO vive aquí: se resuelve desde la variable de
# entorno DEEPSEEK_API_KEY, o LLM_API_KEY en este .env.

# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com

# Directorios que el agente puede listar/leer/escribir, separados por ':'
# (default: el directorio actual)
# AGENT_ALLOWED_DIRS=/home/usuario/documentos

# Carpeta por defecto del informe map-reduce (default: directorio actual)
# INFORME_CARPETA=/ruta/a/trazas

# Tope de rondas de herramientas por pregunta del chat (default 8)
# Directiva de forma del código que genera el chat (exp/51): 1 = pide el
# mínimo código que funciona (default); 0 = la apaga (solo para el A/B del
# banco). El efecto está medido: −79%/−67% de líneas según modelo.
# PROMPT_FORMA=1
# MAX_TOOL_ROUNDS=8
# Techo adaptativo por operación (exp/13, opción C): si el invocador declara
# shared["operacion"], el perfil elegido gana sobre MAX_TOOL_ROUNDS (y un
# override explícito en shared["max_tool_rounds"] gana sobre todo). Hoy
# ningún invocador del chat declara operacion: los perfiles están listos pero
# inertes (el banco fija el techo con MAX_TOOL_ROUNDS por escenario). Se leen
# al importar: cambiarlos exige reiniciar el proceso.
# MAX_TOOL_ROUNDS_CONSULTA=8
# MAX_TOOL_ROUNDS_BANCO=25
# MAX_TOOL_ROUNDS_APLICACION=40
# Convergencia del loop (exp/52-B): con CORTE_NOVEDAD=k (0 = off, default) se
# retiran las tools tras k rondas SEGUIDAS que no estrenan ninguna llamada
# (tool+argumentos) en la pregunta, con mínimo CORTE_NOVEDAD_MIN rondas.
# Default off: la regla se activa recién si el A/B del banco la valida
# (exp/52-A midió que la cola gasta 85% de las rondas; falta el A/B real).
# CORTE_NOVEDAD=0
# CORTE_NOVEDAD_MIN=3
# Skills declarativas (exp/55, Mesa 7): un YAML en skills/ con condición regex,
# prompt y subset de tools. En enforce, el disparo fuerza herramientas, inyecta
# el prompt y el loop anuncia solo ese subset (guía, no sandbox). 0 = apagado.
# SKILLS=1
# Webhook autenticado (Mesa 7, exp/57) sobre el server HITL web. Con
# WEBHOOK_TOKEN vacío el endpoint POST /webhook queda DESHABILITADO (503);
# el token se compara en tiempo constante y nunca se loguea. Los eventos se
# persisten en WEBHOOK_LOG (JSONL, gitignored). Límites: cuerpo y por minuto.
# Arranque del servicio: python3 main.py webhook
# WEBHOOK_TOKEN=
# WEBHOOK_LOG=salidas/webhooks.jsonl
# WEBHOOK_MAX_BYTES=65536
# WEBHOOK_MAX_POR_MINUTO=60
# Chat web MVP (Mesa 8, exp/59): SSE con stdlib sobre el mismo server. Cada
# sesión corre el chat real en un subproceso aislado; el texto no se persiste
# (el hijo usa PREGUNTAS_LOG=0). Con WEBCHAT=0 las rutas /chat dan 404.
# Servicio: WEBCHAT=1 python3 main.py webhook
# WEBCHAT=0
# WEBCHAT_MAX_SESIONES=3
# WEBCHAT_TTL=900
# Escape por no-progreso (exp/13, opción D): repeticiones IDÉNTICAS de la
# misma ronda de tools (mismo nombre y argumentos) antes de retirar las tools
# sin esperar el techo. El contador es por pregunta (lo reinicia cada mensaje
# nuevo del usuario). Se lee al importar: cambiarlo exige reiniciar.
# UMBRAL_SIN_PROGRESO=3
# Log de preguntas del usuario (exp/34): una línea JSON por pregunta en
# salidas/preguntas.jsonl (gitignored). Es lo que permite calibrar el router
# con tráfico REAL — el trace no guarda texto y los logs del banco van con
# echo off. Cualquier fallo de escritura se traga: nunca corta el chat.
# PREGUNTAS_LOG=1
# PREGUNTAS_ARCHIVO=salidas/preguntas.jsonl
# Compacción de contexto (12-factor #5): si el historial serializado del
# chat supera este tope de caracteres, la zona fría se reemplaza por un
# resumen [compacción] (código puro, sin LLM) y solo queda la ventana
# caliente (system + últimos 6 mensajes, con assistant+tools como unidad
# indivisible). El costo se paga una vez por ronda. 0 lo apaga.
# COMPACTION_CHARS=60000
# Máximo de caracteres que devuelve read_file (corta el medio)
# READ_MAX_CHARS=24000
# Concurrencia del mapa paralelo del informe (semáforo anti-429)
# MAPA_CONCURRENCIA=8

# Servidores MCP que el agente consume: nombre::comando ; otro::comando2
# MCP_SERVERS=matematica::python3 /ruta/a/servidor.py
# Capabilities que main.py mcp-server expone a otros agentes
# MCP_EXPOSE=list_files,read_file,search_files,rag_search,rag_index,answer_verified

# Agentes remotos A2A (protocolo agent2agent) que el agente consume:
# JSON {"nombre": "http://host:puerto"}. Las tools agentes_remotos/a2a_tarea
# listan su agent card (/ .well-known/agent.json) y les envían tareas
# (JSON-RPC 2.0 message/send). Sin setting, las tools lo dicen y no tocan
# la red; un agente caído se reporta 'inaccesible' sin romper el listado.
# A2A_AGENTS={"eco": "http://127.0.0.1:9000"}

# Router Laya (if inteligente local): activo por defecto; 0 lo apaga
# (sin checkpoint disponible, degrada a herramientas: el chat no se rompe)
# USE_LAYA_ROUTER=1

# Streaming de respuestas del chat: con 1 (default) la respuesta se imprime
# token a token mientras se genera; 0 vuelve a la versión clásica (completa
# al final). Aplica al chat (AgentStep/DirectAnswer), no al supervisor.
# CHAT_STREAM=1
# Interrupción del stream: con 1 (default), Ctrl+C mientras se genera corta
# la respuesta y el chat sigue (se conserva lo parcial); 0 propaga el Ctrl+C
# (salida del chat). Solo aplica con CHAT_STREAM=1.
# CHAT_STREAM_INTERRUPT=1
# Checkpoint afinado para el router (task router_flow de bmo; 27/30 crudo ECE 0.066 con
# compuerta). Copia el checkpoint a .modelos/ o apunta al path de bmo:
# LAYA_MODEL=.modelos/router_flow-1k
# JUBILADOS por el bench del supervisor (2026-10-13): el Choose local y la
# mayoría 2-de-3 se retiraron — un paso = UNA llamada (tool+args juntos) y
# las leyes L8 viven como guardas de código. El checkpoint queda como
# evidencia histórica: se mide con sonda_supervisor.py pasándolo por args.
# LAYA_MODEL_SUPERVISOR=.modelos/supervisor_dispatch-1k
# LAYA_UNSURE_HIGH_SUPERVISOR=0.9
# LAYA_MODEL_VOTO=.modelos/router_voto  # Mesa 3: voto local; sin él, arbitra DeepSeek
# Mayoría 2-de-3 del VOTO del router (no del supervisor, jubilado):
# USE_VOTACION=1
# Compuerta del router (veredicto "met" del lado directo). 0.85 = rodilla de
# la curva medida (exp/8): bloquea el falso-directo "mundial" (0.83) sin
# perder ningún directo-correcto en la banda 0.7-0.85.
# LAYA_UNSURE_HIGH=0.85
# Umbral propio del voto (segunda capa): su curva está bien a 0.7 (96%
# precisión, 83% cobertura local) — separado para no arrastrarlo al router.
# LAYA_UNSURE_HIGH_VOTO=0.7
# LAYA_UNSURE_LOW=0.3
# Compuerta conformal del router (exp/30/31): con LAYA_CALIBRACION_ROUTER
# apuntando a un JSONL {"conf", "correcto"} etiquetado APARTE del test, el
# umbral del router SALE de esos datos para el riesgo LAYA_ALPHA (cobertura
# marginal >= 1-alpha) y una decisión local se acepta solo si el conjunto de
# etiquetas plausibles colapsa a una. Sin archivo, o si con ese n no hay cota,
# rige el umbral fijo de arriba (degradación por default). El archivo se lee en
# cada decisión: no hay estado que quede viejo.
# LAYA_CALIBRACION_ROUTER=salidas/evals/conformal_calibracion_router.jsonl
# LAYA_ALPHA=0.10
# Modo del router (exp/35). enforce (default) aplica la decisión — el
# comportamiento de siempre; shadow la REGISTRA pero conserva herramientas
# (mide sin cambiar la conducta y ahorra el voto de DeepSeek); off no ejecuta
# exp/43: en shadow cada decisión con probabilidades gana un id y, cuando
# DeepSeek responde la pregunta, una línea "resultado" registra si usó tools
# (uso_tools) — la ETIQUETA AMBIENTAL. banco/probes/etiquetar_ambiental.py
# une decisión↔resultado por id y produce el JSONL de calibración (conf +
# correcto) con tráfico real; con LAYA_LOG_PREGUNTA=1 la etiqueta lleva la
# pregunta (default 0: sin texto del usuario).
# Laya. La política vive en utils/laya_routing.py, separada de la inferencia.
# LAYA_MODO=enforce
# Registro de decisiones: una línea JSON por turno con propuesta, ruta
# aplicada, causa, p(directo), q, umbral y versión de laya. Bookkeeping: si
# falla no rompe el chat. LAYA_LOG_DECISIONES=0 lo apaga.
# LAYA_LOG_DECISIONES=1
# LAYA_LOG_ARCHIVO=salidas/routing.jsonl
# exp/46: la regla temporal manda al lado seguro (herramientas) las preguntas
# con recencia (último/hoy/2026...) SIN gastar a Laya — la familia no juzga
# fechas. En shadow Laya sigue consultando para juntar la etiqueta de esa clase.
# Con LAYA_LOG_PREGUNTA=1 el evento agrega los primeros 200 caracteres de la
# pregunta: es lo que permite etiquetar el registro con
# banco/probes/etiquetar_router.py --extra salidas/routing.jsonl y elegir alpha
# con tráfico real. Default 0: el registro no guarda texto del usuario.
# LAYA_LOG_PREGUNTA=0
# Tope de checkpoints cargados en el proceso (exp/32). Cada uno pesa 2,86 GiB
# de RSS: al pasarse, se descarga el agente MENOS usado y la RAM vuelve al SO.
# El desalojo ocurre ANTES de cargar el nuevo: el pico nunca supera el tope.
# LAYA_MAX_EN_PROCESO=2
# Tamaño de lote de la inferencia en lote (prefiltro de memoria/RAG). Sin
# definir, TODOS los estados viajan en un solo forward y el pico de memoria
# crece con la cantidad de candidatos; con un N positivo se parte en lotes.
# LAYA_BATCH_SIZE=0

# Autonomía del harness: con 0 (default) los settings salen SOLO del entorno y
# del .env de ESTE proyecto. Con 1 se lee además ~/Documentos/00_IA/bmo/.env, el
# comportamiento viejo (dependencia invisible: de ahí salían la API key y el
# modelo). Si lo activás, un cambio en el otro proyecto te cambia este.
# LEER_BMO_ENV=0

# HITL web: con 1, las aprobaciones de write_file/edit_file/run_command se
# responden desde el navegador (http://127.0.0.1:8765) en vez de 's/n' por
# terminal. Puerto y timeout (segundos) configurables; timeout => rechazo.
# HITL_WEB=0
# HITL_WEB_PORT=8765
# HITL_WEB_TIMEOUT=300

# HITL graduado + hooks: con 1 (default), run_command clasifica cada comando
# por riesgo ANTES de preguntar (utils/policy.py, determinista, sin LLM):
#   - 'auto'            solo-lectura verificado (pytest/grep/ls/git status…)
#                       se ejecuta sin s/n, imprimiendo igual el comando.
#   - 'preguntar'       todo lo no reconocido (default) — un s/n como hoy.
#   - 'confirmar_doble' git push y rm -rf piden DOS s/n seguidos.
# Con 0, todo comando pregunta como siempre (compatibilidad).
# HITL_AUTO=1

# Memoria entre sesiones: la biblioteca consultable en memoria/ (tools
# memory_search / memory_save). Con 1 (default) al salir el chat guarda un
# resumen automático en memoria/sesion_FECHA.md (bookkeeping, sin HITL);
# 0 lo apaga. La memoria NO se inyecta al inicio: el agente la consulta.
# MEMORIA=1
# Carpeta de la biblioteca de memoria (default: memoria/)
# MEMORIA_DIR=memoria
# Pre-filtro de contexto por Laya (Mesa 6, 12-factor #5): con 1 (default),
# un juicio local elige qué archivos/notas de memoria entran ANTES de
# leerlos (memory_search) y qué fragmentos del RAG van al prompt
# (rag_search), recortando a *_N. Sin checkpoint entrenado (LAYA_MODEL_PREFILTRO),
# el filtro es no-op: entran todos, como siempre (no se pierde recall).
# MEMORIA_PREFILTRO=1
# MEMORIA_PREFILTRO_N=8
# RAG_PREFILTRO=1
# RAG_PREFILTRO_N=4
# Checkpoint de Laya para el pre-filtro (sin él, no-op)
# LAYA_MODEL_PREFILTRO=.modelos/router_prefiltro

# Directorio de los tests a mano de bmo que leen las sondas (sonda_laya,
# sonda_router, sonda_supervisor). Default: ~/Documentos/00_IA/bmo/train/tasks
# BMO_TASKS_DIR=/ruta/a/bmo/train/tasks

# ---------------------------------------------------------------------------
# Settings que el código ya leía y no estaban documentados (consolidación
# 2026-10-15). Todos opcionales; el valor mostrado es el default del código.
# ---------------------------------------------------------------------------

# Router/voto: calibración conformal del VOTO local (mismo patrón que
# LAYA_CALIBRACION_ROUTER, una capa abajo; artefacto de banco/probes/calibrar_voto.py)
# LAYA_CALIBRACION_VOTO=salidas/evals/conformal_calibracion_voto.jsonl
# LAYA_ALPHA_VOTO=0.10
# Segundos que un checkpoint de Laya que falló al cargar queda en cuarentena
# antes de reintentar (antes el error era permanente para toda la sesión)
# LAYA_ERROR_COOLDOWN=60
# Los umbrales LAYA_UNSURE_HIGH* deben estar en [0, 1]: NaN, inf o fuera de
# rango se ignoran con aviso y rige el default.

# Juez de riesgo en observación (exp/44): sin checkpoint, no-op total
# LAYA_MODEL_RIESGO=.modelos/riesgo
# RIESGO_LOG=1
# RIESGO_ARCHIVO=salidas/riesgo.jsonl

# Procedencia de las decisiones HITL en el log de riesgo (exp/44): el driver
# del banco lo pone en 1 para marcar tráfico sintético. NO lo setees a mano.
# BANCO=0
# Pre-fetch declarativo (exp/50): si la pregunta menciona archivos existentes
# dentro de las raíces, se leen antes de la primera llamada. 0 lo apaga.
# PREFETCH=1
# PREFETCH_MAX_ARCHIVOS=2
# PREFETCH_MAX_LINEAS=80

# Persistencia del thread (exp/48): checkpoint del shared por ciclo, para
# `main.py resume <id>`. 0 apaga todo (ni crea el directorio).
# THREAD_PERSIST=1
# THREADS_DIR=salidas/threads

# Concurrencia del juez en lote (semáforo anti-429)
# JUEZ_LOTE_CONCURRENCIA=8

# Base SQLite de trazas para las tools sql/db_schema (se abre en solo lectura)
# DB_PATH=trazas.db

# Proveedor de búsqueda web (hoy solo ddgs está implementado)
# SEARCH_PROVIDER=ddgs

# Traza por nodo en .runs/ (0 la apaga)
# TRACE=1

# Color de terminal: NO_COLOR (estándar) o COLOR=0 lo apagan
# NO_COLOR=1
# COLOR=0

# Interno de sonda_laya.py (lo setea la sonda; no hace falta tocarlo)
# SONDA_LAYA_CKPT=

# Verificación de citas archivo:línea en la respuesta final: comprueba que la
# línea exista y muestre su contenido; si no coincide, pide una segunda pasada
# de corrección al modelo. 0 la apaga.
# CITAS_VERIFICAR=1
