+PROMPT_ARBITRO_VOTO = (
+    "Pregunta del usuario:\n{pregunta}\n\n"
+    "¿Responderla requiere USAR HERRAMIENTAS (leer/buscar archivos, web, "
+    "ejecutar una capacidad: debate, investigación, informe, sql...) o se "
