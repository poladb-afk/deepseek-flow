+    "listá", "lista", "listame", "listáme",
+    "mostrá", "muestra", "mostrame", "mostráme",
+    "verificá", "verifica",
+    "ejecutá", "ejecuta",
+    "extraé", "extrae",
+})
+
+_RE_OBJETO_CAPACIDAD = re.compile(
