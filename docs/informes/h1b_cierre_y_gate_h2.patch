+            fallas.append(f"el transcript no matchea {valor!r}")
+        elif tipo == "comando":
+            r = subprocess.run(valor, shell=True, cwd=RAIZ, capture_output=True, timeout=300)
+            if r.returncode:
+                fallas.append(f"`{valor}` salió {r.returncode}")
+    return fallas
+
+
+def _validar_chequeos(ruta, turno):
