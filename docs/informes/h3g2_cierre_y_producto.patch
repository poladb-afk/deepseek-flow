diff -ruN -x __pycache__ -x .ruff_cache -x salidas -x '*.pyc' -x .pytest_cache -x baseline.json a/deepseek-flow-main/banco/probes/producto_router.py b/deepseek-flow-main/banco/probes/producto_router.py
