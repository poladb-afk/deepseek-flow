# Copia este archivo a .env y ajusta lo que necesites.
# La API key de DeepSeek NO vive aquí: se resuelve desde la variable de
# entorno DEEPSEEK_API_KEY, o LLM_API_KEY en este .env.

# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com

# Directorios que el agente puede listar/leer/escribir, separados por ':'
# (default: el directorio actual)
# AGENT_ALLOWED_DIRS=/home/usuario/documentos

# Carpeta por defecto del informe map-reduce (default: directorio actual)
# INFORME_CARPETA=/ruta/a/trazas

# Tope de rondas de herramientas por pregunta del chat (default 8)
# MAX_TOOL_ROUNDS=8
# Máximo de caracteres que devuelve read_file (corta el medio)
# READ_MAX_CHARS=24000
# Concurrencia del mapa paralelo del informe (semáforo anti-429)
# MAPA_CONCURRENCIA=8

# Servidores MCP que el agente consume: nombre::comando ; otro::comando2
# MCP_SERVERS=matematica::python3 /ruta/a/servidor.py
# Capabilities que main.py mcp-server expone a otros agentes
# MCP_EXPOSE=list_files,read_file,search_files,rag_search,rag_index,answer_verified

# Router Laya (if inteligente local): activo por defecto; 0 lo apaga
# (sin checkpoint disponible, degrada a herramientas: el chat no se rompe)
# USE_LAYA_ROUTER=1
# Checkpoint afinado para el router (task router_flow de bmo; 22/24 con
# compuerta). Copia el checkpoint a .modelos/ o apunta al path de bmo:
# LAYA_MODEL=.modelos/router_flow-1k
# El Choose del supervisor (bucle reactivo) usa SU propio checkpoint:
# LAYA_MODEL_SUPERVISOR=.modelos/supervisor_dispatch-1k
# Umbral de despacho local del supervisor (más exigente que el router:
# un paso quemado pesa más que la llamada que ahorra)
# LAYA_UNSURE_HIGH_SUPERVISOR=0.9
# Mayoría 2-de-3 en el despacho dudoso (A: DeepSeek directo,
# B: DeepSeek por eliminación, C: Laya crudo). 0 = voto único
# USE_VOTACION=1
# LAYA_UNSURE_HIGH=0.7
# LAYA_UNSURE_LOW=0.3
