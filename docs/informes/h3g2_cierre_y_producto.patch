+"""X90: el producto completo del router, capa por capa, sin Laya ni red."""
+import sys
+
+from conftest import RAIZ
+
+sys.path.insert(0, str(RAIZ / "banco" / "probes"))
+
+import producto_router as pr  # noqa: E402
+
+
+def _sin_skill(_p):
